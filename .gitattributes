# Let Git detect text vs. binary and normalise line endings on commit.
* text=auto eol=lf

# Documentation and tooling dotfiles.
*.md           text eol=lf
*.yml          text eol=lf
*.toml         text eol=lf
*.jsonc        text eol=lf
*.sh           text eol=lf
*.py           text eol=lf
*.svg          text eol=lf
*.txt          text eol=lf
.editorconfig  text eol=lf
.gitignore     text eol=lf
.gitattributes text eol=lf

# Binary assets.
*.png  binary

# The banner, the badges and the scripts that render them are documentation;
# the check script and the hook are tooling of the repository. None of them
# counts as its code.
docs/**       linguist-documentation
tools/**      -linguist-detectable
.githooks/*   -linguist-detectable
